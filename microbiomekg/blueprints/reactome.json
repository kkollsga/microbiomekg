      "file": "pathway",
      "pk": "pathway_id",
      "title": "name",
      "properties": {
        "name": "string",
        "species": "string",
        "pathway_source": "string",
        "source_licence": "string",
        "source_id": "string"
      },
      "connections": {
        "junction_edges": {
          "PART_OF_PATHWAY": {
            "file": "pathway_pathway",
            "source_fk": "pathway_id",
            "target": "Pathway",
            "target_fk": "parent_pathway_id",
            "properties": [
              "primary_source",
              "source_licence",
              "source_relation"
            ],
            "property_types": {
              "primary_source": "string",
