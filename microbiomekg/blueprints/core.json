{
  "_doc": "The shared spine every source writes rows into: the taxon side of the graph (Taxon + HAS_PARENT + the UnresolvedTaxon tombstone), the three condition types the CURIE prefix routes to, Study/Paper, and the one ASSOCIATED_WITH junction edge that spans them. `target` is a list and `target_type_column` names the column holding each row's target type, so one relation is one relationship name over a union range (kglite 0.16.22; docs/model.md section 8). Disease/Phenotype/Exposure carry the secondary label `Condition`, so the ontology's abstract union class is matchable as `(:Condition)` without materialize_ontology() and without re-rooting the is_a forest. A source fragment adds to this; it only edits this file when it needs a genuinely new shared column.",
  "settings": {
    "output": "graph/microbiomekg.kgl"
  },
  "ontology": "ontology.json",
  "_files": "Every table this fragment reads, declared once. A frame the build hands over by name; the preps fill it, nothing on disk backs it.",
  "files": {
    "disease": {
      "format": "frame"
    },
    "exposure": {
      "format": "frame"
    },
    "paper": {
      "format": "frame"
    },
    "phenotype": {
      "format": "frame"
    },
    "study": {
      "format": "frame"
    },
    "taxon": {
      "format": "frame"
    },
    "taxon_condition": {
      "format": "frame"
    },
    "unresolved_taxa": {
      "format": "frame"
    }
  },
  "nodes": {
    "Taxon": {
      "file": "taxon",
      "pk": "tax_id",
      "title": "scientific_name",
      "properties": {
        "rank": "string",
        "scientific_name": "string",
        "placeholder": "bool",
        "synonyms": "list",
        "synonyms_text": "string",
        "synonym_count": "int",
        "lineage_species": "string",
        "lineage_genus": "string",
        "lineage_family": "string",
        "lineage_order": "string",
        "lineage_class": "string",
        "lineage_phylum": "string",
        "lineage_kingdom": "string",
        "lineage_domain": "string",
        "probiotic": "bool",
        "probiotic_use_species": "list",
        "probiotic_research_stage": "list",
        "probiotic_reported_name": "list"
      },
      "skipped": [
        "parent_tax_id"
      ],
      "connections": {
        "fk_edges": {
          "HAS_PARENT": {
            "target": "Taxon",
            "fk": "parent_tax_id"
          }
        },
        "junction_edges": {
          "ASSOCIATED_WITH": {
            "file": "taxon_condition",
            "source_fk": "tax_id",
            "target": [
              "Disease",
              "Phenotype",
              "Exposure"
            ],
            "target_type_column": "condition_type",
            "target_fk": "condition_id",
            "properties": [
              "direction",
              "study_design",
              "evidence_level",
              "sequencing_type",
              "statistical_test",
              "group_0_size",
              "group_1_size",
              "pmid",
              "knowledge_level",
              "agent_type",
              "primary_source",
              "source_record_id",
              "source_licence",
              "source_relation",
              "signature_id",
              "study_id",
              "host_species",
              "body_site",
              "significance_threshold",
              "mht_correction"
            ],
            "property_types": {
              "group_0_size": "int",
              "group_1_size": "int",
              "pmid": "int",
              "significance_threshold": "float",
              "direction": "string",
              "study_design": "string",
              "evidence_level": "string",
              "sequencing_type": "string",
              "statistical_test": "string",
              "signature_id": "string",
              "study_id": "string",
              "host_species": "string",
              "body_site": "string",
              "mht_correction": "string",
              "knowledge_level": "string",
              "agent_type": "string",
              "primary_source": "string",
              "source_record_id": "string",
              "source_licence": "string",
              "source_relation": "string"
            }
          }
        }
      }
    },
    "UnresolvedTaxon": {
      "file": "unresolved_taxa",
      "pk": "unresolved_id",
      "title": "raw_name",
      "properties": {
        "raw_name": "string",
        "reported_rank": "string",
        "original_rank": "string",
        "reported_tax_id": "int",
        "source": "string",
        "status": "string",
        "candidates": "list",
        "note": "string",
        "n_signatures": "int"
      }
    },
    "Study": {
      "file": "study",
      "pk": "study_id",
      "title": "title",
      "properties": {
        "title": "string",
        "journal": "string",
        "year": "int",
        "doi": "string",
        "url": "string",
        "authors": "string",
        "keywords": "string",
        "pmid": "int",
        "pmid_raw": "string",
        "study_number": "string"
      },
      "connections": {
        "fk_edges": {
          "PUBLISHED_AS": {
            "target": "Paper",
            "fk": "pmid"
          }
        }
      }
    },
    "Paper": {
      "file": "paper",
      "pk": "pmid",
      "title": "title",
      "properties": {
        "title": "string",
        "journal": "string",
        "year": "int",
        "doi": "string"
      }
    },
    "Disease": {
      "file": "disease",
      "pk": "condition_id",
      "title": "label",
      "labels": [
        "Condition"
      ],
      "properties": {
        "label": "string",
        "mondo_id": "string",
        "mondo_label": "string",
        "source_id": "string",
        "source_vocabulary": "string",
        "source_condition": "string"
      }
    },
    "Phenotype": {
      "file": "phenotype",
      "pk": "condition_id",
      "title": "label",
      "labels": [
        "Condition"
      ],
      "properties": {
        "label": "string",
        "mondo_id": "string",
        "mondo_label": "string",
        "source_id": "string",
        "source_vocabulary": "string",
        "source_condition": "string"
      }
    },
    "Exposure": {
      "file": "exposure",
      "pk": "condition_id",
      "title": "label",
      "labels": [
        "Condition"
      ],
      "properties": {
        "label": "string",
        "mondo_id": "string",
        "mondo_label": "string",
        "source_id": "string",
        "source_vocabulary": "string",
        "source_condition": "string"
      }
    }
  }
}
