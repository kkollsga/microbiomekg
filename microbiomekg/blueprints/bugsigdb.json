{
  "_doc": "BugSigDB: the Signature node (the taxon SET, which a flattened model would destroy and D1's enrichment needs), the body sites, and the REPORTED_BY provenance edge from both Taxon and its UnresolvedTaxon tombstone. The association rows this source writes go into core.json's taxon_condition table, and IN_CONDITION spans the three condition types the same way ASSOCIATED_WITH does.",
  "_files": "Every table this fragment reads, declared once. A frame the build hands over by name; the preps fill it, nothing on disk backs it.",
  "files": {
    "bodysite": {
      "format": "frame"
    },
    "signature": {
      "format": "frame"
    },
    "signature_bodysite": {
      "format": "frame"
    },
    "signature_condition": {
      "format": "frame"
    },
    "taxon_signature": {
      "format": "frame"
    },
    "unresolved_taxon_signature": {
      "format": "frame"
    }
  },
  "nodes": {
    "Signature": {
      "file": "signature",
      "pk": "signature_id",
      "title": "description",
      "properties": {
        "description": "string",
        "direction": "string",
        "study_design": "string",
        "evidence_level": "string",
        "host_species": "string",
        "location": "string",
        "group_0_size": "int",
        "group_1_size": "int",
        "sequencing_type": "string",
        "variable_region": "string",
        "sequencing_platform": "string",
        "data_transformation": "string",
        "statistical_test": "string",
        "matched_on": "string",
        "confounders": "string",
        "antibiotics_exclusion": "string",
        "significance_threshold": "float",
        "mht_correction": "string",
        "shannon": "float",
        "chao1": "float",
        "richness": "float",
        "pmid": "int",
        "n_taxa": "int",
        "n_unresolved": "int",
        "curated_date": "string",
        "source": "string"
      },
      "skipped": [
        "study_id"
      ],
      "connections": {
        "fk_edges": {
          "PART_OF_STUDY": {
            "target": "Study",
            "fk": "study_id"
          }
        },
        "junction_edges": {
          "IN_CONDITION": {
            "file": "signature_condition",
            "source_fk": "signature_id",
            "target": [
              "Disease",
              "Phenotype",
              "Exposure"
            ],
            "target_type_column": "condition_type",
            "target_fk": "condition_id"
          },
          "AT_BODY_SITE": {
            "file": "signature_bodysite",
            "source_fk": "signature_id",
            "target": "BodySite",
            "target_fk": "bodysite_id"
          }
        }
      }
    },
    "BodySite": {
      "file": "bodysite",
      "pk": "bodysite_id",
      "title": "label",
      "properties": {
        "label": "string",
        "source_id": "string",
        "ontology": "string"
      }
    },
    "Taxon": {
      "connections": {
        "junction_edges": {
          "REPORTED_BY": {
            "file": "taxon_signature",
            "source_fk": "tax_id",
            "target": "Signature",
            "target_fk": "signature_id",
            "properties": [
              "reported_name",
              "reported_rank",
              "original_rank",
              "reported_tax_id",
              "resolution_status",
              "resolution_normalized",
              "resolution_note",
              "direction",
              "source"
            ],
            "property_types": {
              "reported_tax_id": "int",
              "reported_name": "string",
              "reported_rank": "string",
              "resolution_status": "string",
              "resolution_note": "string",
              "direction": "string",
              "source": "string",
              "original_rank": "string",
              "resolution_normalized": "bool"
            }
          }
        }
      }
    },
    "UnresolvedTaxon": {
      "connections": {
        "junction_edges": {
          "REPORTED_BY": {
            "file": "unresolved_taxon_signature",
            "source_fk": "unresolved_id",
            "target": "Signature",
            "target_fk": "signature_id",
            "properties": [
              "reported_name",
              "reported_rank",
              "original_rank",
              "reported_tax_id",
              "resolution_status",
              "resolution_normalized",
              "resolution_note",
              "direction",
              "source"
            ],
            "property_types": {
              "reported_tax_id": "int",
              "reported_name": "string",
              "reported_rank": "string",
              "resolution_status": "string",
              "resolution_note": "string",
              "direction": "string",
              "source": "string",
              "original_rank": "string",
              "resolution_normalized": "bool"
            }
          }
        }
      }
    }
  }
}
