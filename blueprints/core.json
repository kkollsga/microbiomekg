{
  "_doc": "The shared spine every source writes rows into: the taxon side of the graph (Taxon + HAS_PARENT + the UnresolvedTaxon tombstone), the three condition types the CURIE prefix routes to, Study/Paper, and the three ASSOCIATED_WITH* junction edges that are one relation split by the engine's one-target-per-junction rule (docs/model.md section 8). A source fragment adds to this; it only edits this file when it needs a genuinely new shared column.",
  "settings": {
    "root": "./data/csv",
    "output": "graph/microbiomekg.kgl"
  },
  "ontology": "ontology.json",
  "nodes": {
    "Taxon": {
      "csv": "taxon.csv",
      "pk": "tax_id",
      "title": "scientific_name",
      "properties": {
        "rank": "string",
        "scientific_name": "string",
        "placeholder": "bool",
        "synonyms": "string",
        "synonym_count": "int",
        "lineage_species": "string",
        "lineage_genus": "string",
        "lineage_family": "string",
        "lineage_order": "string",
        "lineage_class": "string",
        "lineage_phylum": "string",
        "lineage_kingdom": "string",
        "lineage_domain": "string"
      },
      "skipped": [
        "parent_tax_id"
      ],
      "connections": {
        "fk_edges": {
          "HAS_PARENT": {
            "target": "Taxon",
            "fk": "parent_tax_id"
          }
        },
        "junction_edges": {
          "ASSOCIATED_WITH": {
            "csv": "taxon_disease.csv",
            "source_fk": "tax_id",
            "target": "Disease",
            "target_fk": "condition_id",
            "properties": [
              "direction",
              "study_design",
              "evidence_level",
              "sequencing_type",
              "statistical_test",
              "group_0_size",
              "group_1_size",
              "pmid",
              "knowledge_level",
              "agent_type",
              "primary_source",
              "source_record_id",
              "source_licence",
              "source_relation",
              "signature_id",
              "study_id",
              "host_species",
              "body_site",
              "significance_threshold",
              "mht_correction"
            ],
            "property_types": {
              "group_0_size": "int",
              "group_1_size": "int",
              "pmid": "int",
              "significance_threshold": "float",
              "direction": "string",
              "study_design": "string",
              "evidence_level": "string",
              "sequencing_type": "string",
              "statistical_test": "string",
              "signature_id": "string",
              "study_id": "string",
              "host_species": "string",
              "body_site": "string",
              "mht_correction": "string",
              "knowledge_level": "string",
              "agent_type": "string",
              "primary_source": "string",
              "source_record_id": "string",
              "source_licence": "string",
              "source_relation": "string"
            }
          },
          "ASSOCIATED_WITH_PHENOTYPE": {
            "csv": "taxon_phenotype.csv",
            "source_fk": "tax_id",
            "target": "Phenotype",
            "target_fk": "condition_id",
            "properties": [
              "direction",
              "study_design",
              "evidence_level",
              "sequencing_type",
              "statistical_test",
              "group_0_size",
              "group_1_size",
              "pmid",
              "knowledge_level",
              "agent_type",
              "primary_source",
              "source_record_id",
              "source_licence",
              "source_relation",
              "signature_id",
              "study_id",
              "host_species",
              "body_site",
              "significance_threshold",
              "mht_correction"
            ],
            "property_types": {
              "group_0_size": "int",
              "group_1_size": "int",
              "pmid": "int",
              "significance_threshold": "float",
              "direction": "string",
              "study_design": "string",
              "evidence_level": "string",
              "sequencing_type": "string",
              "statistical_test": "string",
              "signature_id": "string",
              "study_id": "string",
              "host_species": "string",
              "body_site": "string",
              "mht_correction": "string",
              "knowledge_level": "string",
              "agent_type": "string",
              "primary_source": "string",
              "source_record_id": "string",
              "source_licence": "string",
              "source_relation": "string"
            }
          },
          "ASSOCIATED_WITH_EXPOSURE": {
            "csv": "taxon_exposure.csv",
            "source_fk": "tax_id",
            "target": "Exposure",
            "target_fk": "condition_id",
            "properties": [
              "direction",
              "study_design",
              "evidence_level",
              "sequencing_type",
              "statistical_test",
              "group_0_size",
              "group_1_size",
              "pmid",
              "knowledge_level",
              "agent_type",
              "primary_source",
              "source_record_id",
              "source_licence",
              "source_relation",
              "signature_id",
              "study_id",
              "host_species",
              "body_site",
              "significance_threshold",
              "mht_correction"
            ],
            "property_types": {
              "group_0_size": "int",
              "group_1_size": "int",
              "pmid": "int",
              "significance_threshold": "float",
              "direction": "string",
              "study_design": "string",
              "evidence_level": "string",
              "sequencing_type": "string",
              "statistical_test": "string",
              "signature_id": "string",
              "study_id": "string",
              "host_species": "string",
              "body_site": "string",
              "mht_correction": "string",
              "knowledge_level": "string",
              "agent_type": "string",
              "primary_source": "string",
              "source_record_id": "string",
              "source_licence": "string",
              "source_relation": "string"
            }
          }
        }
      }
    },
    "UnresolvedTaxon": {
      "csv": "unresolved_taxa.csv",
      "pk": "unresolved_id",
      "title": "raw_name",
      "properties": {
        "raw_name": "string",
        "reported_rank": "string",
        "original_rank": "string",
        "reported_tax_id": "int",
        "source": "string",
        "status": "string",
        "candidates": "string",
        "note": "string",
        "n_signatures": "int"
      }
    },
    "Study": {
      "csv": "study.csv",
      "pk": "study_id",
      "title": "title",
      "properties": {
        "title": "string",
        "journal": "string",
        "year": "int",
        "doi": "string",
        "url": "string",
        "authors": "string",
        "keywords": "string",
        "pmid": "int",
        "pmid_raw": "string",
        "study_number": "string"
      },
      "connections": {
        "fk_edges": {
          "PUBLISHED_AS": {
            "target": "Paper",
            "fk": "pmid"
          }
        }
      }
    },
    "Paper": {
      "csv": "paper.csv",
      "pk": "pmid",
      "title": "title",
      "properties": {
        "title": "string",
        "journal": "string",
        "year": "int",
        "doi": "string"
      }
    },
    "Disease": {
      "csv": "disease.csv",
      "pk": "condition_id",
      "title": "label",
      "properties": {
        "label": "string",
        "mondo_id": "string",
        "mondo_label": "string",
        "source_id": "string",
        "source_vocabulary": "string",
        "source_condition": "string"
      }
    },
    "Phenotype": {
      "csv": "phenotype.csv",
      "pk": "condition_id",
      "title": "label",
      "properties": {
        "label": "string",
        "mondo_id": "string",
        "mondo_label": "string",
        "source_id": "string",
        "source_vocabulary": "string",
        "source_condition": "string"
      }
    },
    "Exposure": {
      "csv": "exposure.csv",
      "pk": "condition_id",
      "title": "label",
      "properties": {
        "label": "string",
        "mondo_id": "string",
        "mondo_label": "string",
        "source_id": "string",
        "source_vocabulary": "string",
        "source_condition": "string"
      }
    }
  }
}
