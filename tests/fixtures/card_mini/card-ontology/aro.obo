property_value: classified_as_amr_gene_family

[Term]
id: ARO:3000236
name: glycopeptide resistance gene cluster VanA
namespace: antibiotic_resistance
def: "This inducible cluster confers high resistance to both vancomycin and teicoplanin by allowing restructuring of peptidoglycan precursors to end in D-Ala-D-Lac. The vanA gene cluster can be located either on plasmids or on the chromosome. Gene orientation: vanRSHAXYZ." [PMID:16323116, PMID:8843432, PMID:8380148]
is_a: ARO:3000234 ! glycopeptide resistance gene cluster
relationship: confers_resistance_to_antibiotic ARO:0000028 ! vancomycin
relationship: confers_resistance_to_antibiotic ARO:0000029 ! teicoplanin
synonym: "vanA_cluster" EXACT CARD_Short_Name []

[Term]
id: ARO:3000244
