synonym: "aminoglycoside kinase" EXACT []

[Term]
id: ARO:3000119
name: edeine
namespace: antibiotic_resistance
def: "Edeines are basic linear peptides produced by Bacillus brevis Vm4. They have antibacterial as well as antifungal, antiviral, and anticancer properties. Edeines are bacteriostatic and bacteriocidal at low and high concentrations, respectively. They are able to inhibit DNA synthesis and protein translation. These compounds are synthesized by nonribosomal peptide synthetases and contain numerous unusual amino acids." [PMID:70202]
is_a: ARO:3009657 ! nonribosomal peptide antibiotics

[Term]
id: ARO:3000121
name: aminoglycoside acetyltransferase (AAC)
namespace: antibiotic_resistance
def: "Aminoglycoside acetyltransferase enzymes modify aminoglycoside antibiotics by catalyzing the transfer of an acetyl group to one of the amino groups present in aminoglycosides, using acetyl coenzyme A as a donor substrate." [PMID:20833577]
is_a: ARO:3007380 ! aminoglycoside modifying enzyme
relationship: participates_in ARO:3000106 ! acylation of antibiotic conferring resistance
synonym: "aminoglycoside N-acetyltransferase" EXACT []

[Term]
id: ARO:3000125
name: hydrolysis of fosfomycin epoxide ring
namespace: antibiotic_resistance
def: "The use of different nucleophilic molecules by enzymes can break up the epoxide ring of fosfomycin and render the molecule ineffective." []
is_a: ARO:3000040 ! hydrolysis of antibiotic conferring resistance

[Term]
id: ARO:3000126
name: APH(3')
namespace: antibiotic_resistance
def: "A category of aminoglycoside O-phosphotransferase enzymes with modification regiospecificity based at the 3'-hydroxyl group of the respective antibiotic. These enzymes inactivate aminoglycoside antibiotics, specifically kanamycin and neomycin, by the ATP-dependent phosphorylation of the 3'-hydroxyl group of the compound." [PMID:8385262, PMID:9200607]
is_a: ARO:3000114 ! aminoglycoside phosphotransferase (APH)
relationship: confers_resistance_to_drug_class ARO:0000016 ! aminoglycoside antibiotic
property_value: classified_as_amr_gene_family

[Term]
id: ARO:3000130
name: edeine A
namespace: antibiotic_resistance
def: "Edeine A is a subtype of the peptide antibiotic edeine, composed of beta-tyr, beta-ser, diaminopropionic acid, diaminohydroxyazelaic acid, glycine, and spermidine. Edeine A is a mixture of edeine A1 and its inactive isomer, edeine A2. Edeines bind to the 30S subunit to block fMet-tRNA interaction at the P site, inhibiting protein synthesis and subsequent structure/function processes critical for life or replication." [PMID:4984939, PMID:14731399, PMID:70202]
is_a: ARO:3000119 ! edeine
is_a: ARO:3009657 ! nonribosomal peptide antibiotics
xref: PubChem:379085
property_value: classified_as_antibiotic

[Term]
