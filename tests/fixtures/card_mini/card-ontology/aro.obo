property_value: classified_as_efflux_component

[Term]
id: ARO:3000164
name: Ribosomal RNA methyltransferase conferring antibiotic resistance
namespace: antibiotic_resistance
def: "Ribosomal RNA (rRNA) methyltransferases are a functional class of enzymes which catalyze the addition of S-adenosylmethionine to specific nucleotide bases in ribosomal RNA. The addition of a methyl group at select positions is associated with antibiotic resistance via antibiotic target protection." [PMID:1929280]
is_a: ARO:3000519 ! antibiotic target modifying enzyme
relationship: participates_in ARO:3000211 ! ribosomal alteration conferring antibiotic resistance

[Term]
id: ARO:3000169
name: rifampin
namespace: antibiotic_resistance
def: "Rifampin is a semi-synthetic rifamycin, and inhibits RNA synthesis by binding to RNA polymerase. Rifampin is the mainstay agent for the treatment of tuberculosis, leprosy and complicated Gram-positive infections." [PMID:15667909, PMID:6356275]
