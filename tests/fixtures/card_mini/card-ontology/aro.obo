[Term]
id: ARO:3007725
name: OXA-51-like beta-lactamase
namespace: antibiotic_resistance
def: "The maximum number of blaOXA belonged to the OXA-51-like subfamily. An earlier study had reported that OXA-51-like enzymes were present exclusively in A. baumannii. Similar to most of the other OXA-type carbapenemases, the OXA-51-like enzymes show weak carbapenemase activity; however, the presence of the insertion sequence ISAba1 upstream of the blaOXA-51-like gene may provide a promoter that allows the overproduction of carbapenemase, and this results in carbapenem resistance." [PMID:17724156, PMID:24696435]
is_a: ARO:3000017 ! OXA beta-lactamase
relationship: confers_resistance_to_drug_class ARO:0000020 ! carbapenem
relationship: confers_resistance_to_drug_class ARO:3000008 ! penicillin beta-lactam
property_value: classified_as_amr_gene_family

[Term]
id: ARO:3009105
name: first-generation cephalosporin
namespace: antibiotic_resistance
def: "First-generation cephalosporin antibiotics include those with a relatively narrow spectrum of activity, primarily effective against gram-positive cocci and with minimal coverage against gram-negative bacteria." []
is_a: ARO:0000032 ! cephalosporin
synonym: "1st-generation cephalosporin" EXACT []
property_value: classified_as_drug_subclass

[Term]
id: ARO:3009106
name: second-generation cephalosporin
namespace: antibiotic_resistance
def: "Second-generation cephalosporin antibiotics have increased efficacy against gram-negative bacteria compared to first-generation cephalosporins. This subclass also includes cephamycin antibiotics." []
is_a: ARO:0000032 ! cephalosporin
synonym: "2nd-generation cephalosporin" EXACT []
property_value: classified_as_drug_subclass

[Term]
id: ARO:3009107
name: third-generation cephalosporin
namespace: antibiotic_resistance
def: "Third generation cephalosporin antibiotics have a marked activity against gram-negative bacteria, but diminished activity against gram-positive bacteria." []
is_a: ARO:0000032 ! cephalosporin
synonym: "3rd-generation cephalosporin" EXACT []
property_value: classified_as_drug_subclass

[Term]
id: ARO:3009108
name: fourth-generation cephalosporin
namespace: antibiotic_resistance
def: "Fourth-generation cephalosporins have activity against gram-positive cocci and a broad array of gram-negative bacteria, including Pseudomonas and many of the Enterobacteriaceae with inducible chromosomal beta-lactamases." []
is_a: ARO:0000032 ! cephalosporin
synonym: "4th-generation cephalosporin" EXACT []
property_value: classified_as_drug_subclass

