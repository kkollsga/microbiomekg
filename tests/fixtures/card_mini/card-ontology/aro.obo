relationship: confers_resistance_to_drug_class ARO:3000387 ! phenicol antibiotic
property_value: classified_as_amr_gene_family

[Term]
id: ARO:3000210
name: rifamycin-resistant beta-subunit of RNA polymerase (rpoB)
namespace: antibiotic_resistance
def: "Rifampin resistant RNA polymerases include amino acids substitutions which disrupt the affinity of rifampin for its binding site. These mutations are frequently concentrated in the rif I region of the beta-subunit and most often involve amino acids which make direct interactions with rifampin. However, mutations which also confer resistance can occur outside this region and may involve amino acids which do not directly make contact with rifampin." [PMID:12821473, PMID:11136757, PMID:21300839, PMID:10543773, PMID:22361457, PMID:3050121, PMID:15047531]
is_a: ARO:3000381 ! antibiotic target replacement protein
is_a: ARO:3003276 ! antibiotic resistant rpoB
relationship: confers_resistance_to_drug_class ARO:3000157 ! rifamycin antibiotic
relationship: derives_from ARO:3000737 ! rifamycin sensitive beta-subunit of RNA polymerase (rpoB)
property_value: classified_as_amr_gene_family

[Term]
id: ARO:3000211
name: ribosomal alteration conferring antibiotic resistance
namespace: antibiotic_resistance
def: "Chemical alteration of the ribosome results in modification of an antibiotic's target leading to resistance." []
is_a: ARO:0001001 ! antibiotic target alteration

[Term]
id: ARO:3000212
name: mutation conferring antibiotic resistance
namespace: antibiotic_resistance
def: "Point mutations in the DNA may lead to an altered gene product that may result in antibiotic resistance. Examples included modified antibiotic targets with lower binding affinities and the deactivation of repressors that result in increased expression of genes that inactivate or pump out antibiotics." []
is_a: ARO:0001001 ! antibiotic target alteration

[Term]
id: ARO:3000213
name: restructuring of bacterial cell wall conferring antibiotic resistance
namespace: antibiotic_resistance
def: "Peptidoglycan precursors ending in D-Ala-D-Lac or D-Ala-D-Ser instead of D-Ala-D-Ala conferring high level glycopeptide resistance." [PMID:1931965, PMID:9177243]
is_a: ARO:0001001 ! antibiotic target alteration
synonym: "molecular bypass conferring antibiotic resistance" EXACT []

[Term]
id: ARO:3000214
name: hygromycin B
namespace: antibiotic_resistance
def: "Hygromycin B is an aminoglycoside antibiotic used to treat different types of bacterial infections. Hygromycin B works by binding to the bacterial 30S ribosomal subunit, causing misreading of mRNA and leaving the bacterium unable to synthesize proteins vital to its growth. Hygromycin B has also been shown to interact with eukaryotic cells." [PMID:10103173, PMID:11163189]
is_a: ARO:0000016 ! aminoglycoside antibiotic
xref: CAS:31282-04-9
xref: CHEBI:16976
xref: PubChem:35766
property_value: classified_as_antibiotic

[Term]
id: ARO:3000218
name: aminoglycoside nucleotidyltransferase (ANT)
namespace: antibiotic_resistance
def: "Covalent modification of aminoglycoside antibiotic hydroxyl group by ATP-dependent transfer of AMP." [PMID:20833577]
is_a: ARO:3007380 ! aminoglycoside modifying enzyme
relationship: participates_in ARO:3000107 ! nucleotidylation of antibiotic conferring resistance
synonym: "aminoglycoside adenyltransferase" EXACT []

[Term]
id: ARO:3000219
name: mutant efflux regulatory protein conferring antibiotic resistance
namespace: antibiotic_resistance
def: "Efflux regulatory proteins with mutations that result in increased expression of efflux proteins." []
is_a: ARO:0000031 ! antibiotic resistance gene variant or mutant

[Term]
id: ARO:3000221
name: lincosamide nucleotidyltransferase (LNU)
namespace: antibiotic_resistance
