[Term]
id: ARO:3000145
name: tylosin
namespace: antibiotic_resistance
def: "Tylosin is a 16-membered macrolide, naturally produced by Streptomyces fradiae. It interacts with the bacterial ribosome 50S subunit to inhibit protein synthesis." [PMID:19793461]
is_a: ARO:0000000 ! macrolide antibiotic
xref: CAS:1401-69-0
xref: CHEBI:17658
