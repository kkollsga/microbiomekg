[Term]
id: ARO:3000225
name: ANT(6)
namespace: antibiotic_resistance
def: "A category of aminoglycoside O-nucleotidyltransferase enzymes with modification regiospecificity based at the 6-hydroxyl group of the respective antibiotic. These enzymes inactivate aminoglycoside antibiotics, specifically streptomycin, by transfer of an AMP group from an ATP substrate to the 6-hydroxyl group of the compound." []
is_a: ARO:3000218 ! aminoglycoside nucleotidyltransferase (ANT)
relationship: confers_resistance_to_drug_class ARO:0000016 ! aminoglycoside antibiotic
property_value: classified_as_amr_gene_family

[Term]
id: ARO:3000226
name: antibiotic resistant folP
namespace: antibiotic_resistance
def: "Point mutations in dihydropteroate synthase folP prevent sulfonamide antibiotics from inhibiting its role in folate synthesis, thus conferring sulfonamide resistance." [PMID:21115799, PMID:1522070, PMID:9006040, PMID:9593127, PMID:9449266]
is_a: ARO:0000031 ! antibiotic resistance gene variant or mutant
relationship: derives_from ARO:3000744 ! antibiotic sensitive dihydropteroate synthase
synonym: "dihydropteroate synthase" EXACT []

[Term]
id: ARO:3000234
name: glycopeptide resistance gene cluster
namespace: antibiotic_resistance
def: "Genes that when expressed confer resistance to vancomycin and teicoplanin type antibiotics." [PMID:16323116]
is_a: ARO:0000010 ! antibiotic resistance gene cluster, cassette, or operon
